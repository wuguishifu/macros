{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": ["scope:hybrid"],
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf apps/web/.next"
      }
    },
    "build": {
      "defaultConfiguration": "production",
      "dependsOn": ["clean", "^build"]
    },
    "serve": {
      "defaultConfiguration": "development",
      "options": {
        "port": 4200
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^typecheck"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,tsbuildinfo}",
          "transitive": true
        },
        {
          "fileset": "{projectRoot}/**/*.d.ts",
          "dependencies": true
        },
        {
          "externalDependencies": ["next", "typescript"]
        }
      ],
      "outputs": [
        "{projectRoot}/.next/types/**/*.ts",
        "{projectRoot}/dist/tsconfig.tsbuildinfo"
      ],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "options": {
        "cwd": "apps/web",
        "command": "next typegen && tsc --project tsconfig.json --noEmit"
      }
    }
  }
}
