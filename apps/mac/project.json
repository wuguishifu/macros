{
  "name": "mac",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mac/Macros",
  "implicitDependencies": ["core"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "xcodegen generate --quiet",
        "cwd": "apps/mac"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "xcodebuild -project Macros.xcodeproj -scheme Macros -configuration Debug -destination 'generic/platform=macOS' -derivedDataPath ../../dist/apps/mac -quiet build",
        "cwd": "apps/mac"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pkill -x Macros || true; open dist/apps/mac/Build/Products/Debug/Macros.app"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/Macros/**/*.swift", "{workspaceRoot}/.swift-format"],
      "options": {
        "command": "swift format lint --strict --recursive Macros",
        "cwd": "apps/mac"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "swift format --in-place --recursive Macros",
        "cwd": "apps/mac"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'mac:release is not implemented yet (archive -> Developer ID sign -> notarize -> staple -> DMG). See docs/spec.md.' && exit 1"
      }
    }
  }
}
